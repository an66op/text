{
  "name": "orbit-social",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5173 --strictPort",
    "dev:all": "node --env-file-if-exists=.env scripts/dev.mjs",
    "dev:admin": "npm --prefix admin run dev",
    "dev:server": "cd server && APP_ENV=development go run ./cmd/api",
    "db:up": "node scripts/database.mjs up",
    "db:down": "node scripts/database.mjs down",
    "db:status": "node scripts/database.mjs status",
    "db:backup": "node --env-file-if-exists=.env scripts/database-backup.mjs backup",
    "db:restore-check": "node --env-file-if-exists=.env scripts/database-backup.mjs restore-check",
    "media:backup": "node --env-file-if-exists=.env scripts/media-backup.mjs backup",
    "media:restore-check": "node --env-file-if-exists=.env scripts/media-backup.mjs restore-check",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run lint && npm run test && npm run build",
    "build:admin": "npm --prefix admin run build",
    "test:server": "cd server && go test -race ./...",
    "test:admin": "npm --prefix admin run test",
    "test:tooling": "node --test scripts/*.test.mjs",
    "verify:stack": "node scripts/verify-stack.mjs",
    "verify:messages": "cd server && go run ./cmd/verify-messaging",
    "verify:wallet-auth": "cd server && go run ./cmd/verify-wallet-auth",
    "verify:social": "node scripts/verify-social.mjs",
    "verify:media": "node scripts/verify-media.mjs",
    "verify:circles": "node scripts/verify-circles.mjs",
    "verify:notifications": "node scripts/verify-notifications.mjs",
    "verify:circle-events": "node scripts/verify-circle-events.mjs",
    "check:all": "npm run check && npm run build:admin && npm run test:admin && npm run test:server && npm run test:tooling"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router": "^7.18.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.4",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "jsdom": "^30.1.2",
    "prettier": "^3.9.9",
    "typescript": "~5.7.2",
    "typescript-eslint": "^8.71.1",
    "vite": "^6.0.5",
    "vitest": "^5.0.3"
  }
}
