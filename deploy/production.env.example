# Origins have no trailing slash/path. Public HTTPS ingress is required.
APP_ORIGIN=https://app.example.com
ADMIN_ORIGIN=https://admin.example.com
FRONTEND_PORT=8081
ADMIN_PORT=8082

# Absolute paths; keep actual secret files outside this repository.
POSTGRES_ADMIN_PASSWORD_FILE=/etc/gongming/postgres-admin-password
POSTGRES_PASSWORD_FILE=/etc/gongming/postgres-password
BOOTSTRAP_ADMIN_PASSWORD_FILE=/etc/gongming/bootstrap-admin-password

# Set these for first startup on a new, empty production database.
# Clear both after the administrator has been provisioned.
BOOTSTRAP_ADMIN_EMAIL=operator@example.com
BOOTSTRAP_ADMIN_HANDLE=operator
