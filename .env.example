# 本地开发示例；生产环境请使用独立数据库、HTTPS 和强凭据。
APP_ENV=development
DATABASE_URL=postgres://gongming:gongming_dev@127.0.0.1:55432/gongming?sslmode=disable
API_ADDR=127.0.0.1:8080
VITE_API_TARGET=http://127.0.0.1:8080
# 可选绝对路径；dev:all 默认使用项目 .runtime/media 私有目录。
# MEDIA_DIRECTORY=/绝对路径/xo/.runtime/media
# 钱包身份：开发默认仅前台两个Origin；生产必须显式设置，否则关闭。
# WALLET_ORIGINS=https://social.example.com
# WALLET_CHAINS=1,11155111
